# Copy to .env.local for `vercel dev`. Real values live only in Vercel env vars.

# Public base URL of this portal (no trailing slash). Used for Stripe redirect URLs and emails.
APP_URL=http://localhost:3000

# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server only. Used solely by api/clients.js and api/stripe-webhook.js.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe (test mode: sk_test_...)
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_WEBSITE_FEE=price_replace_me
STRIPE_PRICE_MAINTENANCE=price_replace_me
# Optional; omit to use the account's default portal configuration.
STRIPE_PORTAL_CONFIGURATION_ID=bpc_replace_me

# Shared with the CRM. See HANDOFF-CONTRACT.md.
HANDOFF_SECRET=generate-with-openssl-rand-hex-32

# Resend (transactional only)
RESEND_API_KEY=re_replace_me
EMAIL_FROM=Berner Systems Billing <billing@mail.bernersystems.com>
